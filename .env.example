# ==============================================================================
# STUDENT TRACKER — ENVIRONMENT CONFIGURATION TEMPLATE
# Architecture: Firebase-First Application Platform + Supabase Payment Backend (Razorpay)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public Web SDK)
# Safe to expose in client builds. Found in Firebase Console -> Project Settings -> General.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=tracker-e8e6f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tracker-e8e6f
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# ------------------------------------------------------------------------------
# 2. Supabase Client Configuration (Public URL & Anon Key for Payment Edge Functions)
# Used exclusively to route payment checkout, verification, and subscription calls.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# 3. Razorpay Client Configuration (Public Key ID for Razorpay Checkout Modal)
# Used by https://checkout.razorpay.com/v1/checkout.js modal script.
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here

# ==============================================================================
# SERVER-SIDE SECRETS (Supabase Edge Function Secrets / Deno Runtime)
# DO NOT put these in Vite environment files or frontend client code!
# Set these using: supabase secrets set KEY=VALUE
# ==============================================================================
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# FIREBASE_PROJECT_ID=tracker-e8e6f
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# (Note: Razorpay Plan IDs are obsolete; TRAKIFY uses one-time orders only)
