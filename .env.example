# ==============================================================================
# TRACKER — Environment Configuration Reference
# ==============================================================================
# Offline-first notice:
# If client variables are not provided, Tracker automatically runs in 100% offline
# local-first mode using localStorage.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Vercel Project Settings -> Environment Variables)
# These are bundled into the public frontend via Vite. NEVER put secrets here.
# ------------------------------------------------------------------------------

# Supabase Project URL (e.g., https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anonymous API Key (safe for browser exposure with RLS)
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE EDGE FUNCTION SECRETS (Supabase Dashboard -> Edge Functions -> Secrets)
# Configure via: supabase secrets set KEY=VALUE
# NEVER expose these in Vercel or browser code!
# ------------------------------------------------------------------------------

# Stripe Secret API Key (sk_test_... or sk_live_...)
# STRIPE_SECRET_KEY=

# Stripe Webhook Signing Secret (whsec_...) from Stripe Dashboard -> Webhooks
# STRIPE_WEBHOOK_SECRET=

# Server-controlled Price ID for Tracker Pro tier (price_...)
# STRIPE_PRICE_ID_PRO=

# Server-controlled Price ID for Cohort Sponsor tier (price_...)
# STRIPE_PRICE_ID_COHORT=

# YouTube Data API v3 Key (from Google Cloud Console -> APIs & Services -> Credentials)
# Used by the import-youtube-playlist Edge Function to fetch playlists, lectures & durations.
# Configure via: supabase secrets set YOUTUBE_API_KEY=AIzaSy...
# YOUTUBE_API_KEY=

# Note: SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are automatically
# injected into Edge Functions by the Supabase runtime.
