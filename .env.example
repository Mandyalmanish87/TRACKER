# TRACKER — Environment Configuration
# Copy this file to .env.local or .env to configure Google OAuth & Supabase Cloud Sync
# If these variables are not provided, Tracker automatically runs in 100% offline local-first mode!

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anonymous API Key
VITE_SUPABASE_ANON_KEY=

# Setup Instructions:
# 1. Create a free project at https://supabase.com
# 2. In Authentication -> Providers, enable Google and paste your Google Cloud Client ID & Client Secret
# 3. Create a table named `user_trackers` with the following schema:
#    create table user_trackers (
#      user_id uuid primary key references auth.users(id) on delete cascade,
#      data jsonb not null,
#      updated_at timestamp with time zone not null default now()
#    );
#    alter table user_trackers enable row level security;
#    create policy "Users can access their own tracker" on user_trackers
#      for all using (auth.uid() = user_id);
# 4. Paste your project URL and anon public key into .env.local

